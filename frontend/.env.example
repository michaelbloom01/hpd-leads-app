# Backend API URL
# For local development, leave blank to use http://localhost:8000
# For production, set to your Railway backend URL
VITE_API_URL=https://hpd-leads-app-production.up.railway.app

# Google Maps Embed API key (optional - for building location maps)
# Get one at: https://console.cloud.google.com/apis/credentials
# IMPORTANT: Restrict this key to Maps Embed API and your domains only
VITE_GOOGLE_MAPS_KEY=
